{
  "name": "json-api",
  "version": "3.0.0-rc.6.0.1",
  "description": "A library for constructing JSON-API compliant responses",
  "homepage": "https://github.com/ethanresnick/json-api",
  "repository": {
    "type": "git",
    "url": "git://github.com/ethanresnick/json-api.git"
  },
  "author": {
    "name": "Ethan Resnick",
    "email": "ethan.resnick@gmail.com"
  },
  "license": "LGPL-3.0",
  "main": "build/src/index.js",
  "typings": "build/src/index.d.ts",
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "typings",
      "node_modules",
      "test",
      "templates",
      "build",
      "lib/index.d.ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "json",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "dependencies": {
    "@json-api/querystring": "^1.0.0",
    "@types/debug": "0.0.29",
    "@types/depd": "^1.1.32",
    "@types/express": "^4.16.0",
    "@types/lodash": "^4.14.109",
    "@types/node": "18.19.130",
    "@types/pluralize": "0.0.27",
    "@types/pug": "^2.0.4",
    "@types/qs": "^6.5.1",
    "@types/ramda": "^0.25.32",
    "@types/url-template": "^2.0.28",
    "content-type": "^1.0.4",
    "dasherize": "2.0.x",
    "debug": "^3.1.0",
    "depd": "^1.1.2",
    "immutable": "^3.8.4",
    "lodash": "^4.18.1",
    "negotiator": "git+https://github.com/ethanresnick/negotiator.git#e2fe4abc56271b9851132f3e508e7323415c8aea",
    "pluralize": "0.0.11",
    "pug": "^3.0.3",
    "qs": "^6.5.3",
    "ramda": "^0.25.0",
    "raw-body": "^2.3.3",
    "supports-color": "^4.5.0",
    "url-template": "^2.0.4",
    "vary": "^1.1.2"
  },
  "devDependencies": {
    "@ethanresnick/tslint-config": "5.9.1",
    "@types/chai-subset": "^1.3.1",
    "@types/mocha": "^10.0.10",
    "@types/mongoose-geojson-schema": "^2.1.1",
    "@types/sinon": "^17.0.3",
    "@types/superagent": "^8.1.9",
    "body-parser": "^1.20.8",
    "chai": "^4.5.0",
    "chai-subset": "^1.6.0",
    "cpr": "^3.0.1",
    "express": "^4.22.3",
    "mocha": "^11.8.0",
    "mongoose": "6.13.11",
    "mongoose-geojson-schema": "^2.2.4",
    "node-mongoose-fixtures": "^0.3.0",
    "nyc": "^17.1.0",
    "rimraf": "^5.0.10",
    "sinon": "^17.0.1",
    "source-map-support": "^0.5.6",
    "superagent": "^10.2.2",
    "testdouble": "^3.20.2",
    "ts-node": "^10.9.2",
    "tslint": "6.1.3",
    "typescript": "4.9.5"
  },
  "peerDependencies": {
    "mongoose": "^6.0.0",
    "express": "^4.0.0"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.0.3"
    },
    "istanbul-lib-processinfo": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "lint": "npm run lint:src && npm run lint:test",
    "lint:src": "node --require ./scripts/tslint-compat.cjs node_modules/tslint/bin/tslint --project tsconfig.json --format verbose --exclude 'test/**/*' --config ./src/tslint.json",
    "lint:test": "node --require ./scripts/tslint-compat.cjs node_modules/tslint/bin/tslint --project tsconfig.json --format verbose --exclude 'src/**/*' --config ./test/tslint.json",
    "test": "npm run test:tooling && npm run test:install-fixtures && npm run test:fixtures-installed",
    "test:install-fixtures": "NODE_ENV=testing ts-node test/app/database/install-fixtures.ts",
    "test:fixtures-installed": "NODE_ENV=testing mocha --require ts-node/register --extension ts --recursive test/unit/ test/integration/ --full-trace --check-leaks",
    "test:unit": "NODE_ENV=testing mocha --require ts-node/register --extension ts --recursive test/unit/ --full-trace --check-leaks",
    "test:tooling": "node --test test/tooling-security.cjs test/lint-compatibility.cjs",
    "test:debug": "npm run test -- --inspect-brk",
    "build:lintfree": "npm run clean && cpr templates build/templates && echo Using TypeScript && tsc --version && tsc --pretty",
    "build": "npm run lint && npm run build:lintfree",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "cover": "NODE_ENV=test npm run test:install-fixtures && nyc npm run test:fixtures-installed",
    "cover:view": "npm run cover && open coverage/index.html",
    "watch": "npm run build -- --watch",
    "watch:lintfree": "npm run build:lintfree -- --watch",
    "watch:test": "npm run test -- --watch"
  },
  "bugs": {
    "url": "https://github.com/ethanresnick/json-api/issues"
  },
  "keywords": [
    "express",
    "mongoose",
    "json-api",
    "jsonapi",
    "api",
    "hypermedia",
    "rest",
    "restful"
  ],
  "engines": {
    "node": ">=18.20.8"
  }
}
